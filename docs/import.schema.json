{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pattern Atlas data additions v1",
  "description": "Readable keys link records within one import. The app validates references, unique keys, IANA timezones, calendar dates and local DST times. Repeated batch IDs are blocked.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "batch_id",
    "dataset"
  ],
  "properties": {
    "format": {
      "const": "pattern-atlas-data"
    },
    "version": {
      "const": 1
    },
    "batch_id": {
      "type": "string",
      "minLength": 1
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "type": "string"
        },
        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entity"
          }
        },
        "places": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/place"
          }
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/observation"
          }
        }
      }
    }
  },
  "$defs": {
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "name"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "context": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "attributes": {
          "type": "object",
          "additionalProperties": true
        },
        "place_key": {
          "description": "Optional home/default place key in this file; separate from historical event location.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "place": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "name",
        "latitude",
        "longitude",
        "timezone"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "elevation_m": {
          "type": "number"
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "attributes": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "label",
        "date",
        "timezone"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "time": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{2}:\\d{2}:\\d{2}(\\.\\d+)?$"
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "entity_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "place_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "context": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "attributes": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}